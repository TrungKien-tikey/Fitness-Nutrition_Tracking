{
  "info": {
    "_postman_id": "367bd2f7-ad84-4191-896c-7afc6551b26c",
    "name": "Fitness_Nutrition",
    "description": "API tests for the Fitness & Nutrition Tracking API. Start the backend at http://localhost:8081, then run the collection. The collection auto-logs in before protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const baseUrl = pm.variables.get('base_url');",
          "const credentials = {",
          "    username: pm.collectionVariables.get('test_username'),",
          "    password: pm.collectionVariables.get('test_password')",
          "};",
          "const loginRequest = {",
          "    url: baseUrl + '/api/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify(credentials) }",
          "};",
          "const registerRequest = {",
          "    url: baseUrl + '/api/auth/register',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: {",
          "        mode: 'raw',",
          "        raw: JSON.stringify({",
          "            username: credentials.username,",
          "            password: credentials.password,",
          "            email: pm.collectionVariables.get('test_email')",
          "        })",
          "    }",
          "};",
          "const requestUrl = pm.request.url.toString();",
          "const isAuthEndpoint = requestUrl.indexOf('/api/auth/') !== -1;",
          "",
          "if (!isAuthEndpoint && !pm.collectionVariables.get('bearer_token')) {",
          "    pm.sendRequest(loginRequest, function (err, res) {",
          "        if (!err && res.code === 200) {",
          "            pm.collectionVariables.set('bearer_token', res.json().token);",
          "            return;",
          "        }",
          "        pm.sendRequest(registerRequest, function () {",
          "            pm.sendRequest(loginRequest, function (err2, res2) {",
          "                if (!err2 && res2.code === 200) {",
          "                    pm.collectionVariables.set('bearer_token', res2.json().token);",
          "                }",
          "            });",
          "        });",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register succeeds or reports a duplicate', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "    if (pm.response.code === 400) {",
                  "        const message = String(pm.response.json().message);",
                  "        pm.expect(message).to.match(/already (taken|in use)/);",
                  "    }",
                  "});"
