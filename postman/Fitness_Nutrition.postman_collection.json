        {
          "name": "NoData",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.variables.get('base_url');",
                  "const credentials = {",
                  "    username: pm.collectionVariables.get('fresh_username'),",
                  "    password: pm.collectionVariables.get('fresh_password')",
                  "};",
                  "const loginRequest = {",
                  "    url: baseUrl + '/api/auth/login',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify(credentials) }",
                  "};",
                  "const registerRequest = {",
                  "    url: baseUrl + '/api/auth/register',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            username: credentials.username,",
                  "            password: credentials.password,",
                  "            email: pm.collectionVariables.get('fresh_email')",
                  "        })",
                  "    }",
                  "};",
                  "if (!pm.collectionVariables.get('fresh_token')) {",
                  "    pm.sendRequest(loginRequest, function (err, res) {",
                  "        if (!err && res.code === 200) {",
                  "            pm.collectionVariables.set('fresh_token', res.json().token);",
                  "            return;",
                  "        }",
                  "        pm.sendRequest(registerRequest, function () {",
                  "            pm.sendRequest(loginRequest, function (err2, res2) {",
                  "                if (!err2 && res2.code === 200) {",
                  "                    pm.collectionVariables.set('fresh_token', res2.json().token);",
                  "                }",
                  "            });",
                  "        });",
                  "    });",
                  "}"
                ]
              }
            }
