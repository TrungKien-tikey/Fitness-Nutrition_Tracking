          "name": "Generate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Diet plan generated successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Plan contains a valid 7-day menu', function () {",
                  "    pm.expect(json.goal).to.eql('WEIGHT_LOSS');",
                  "    pm.expect(json).to.have.property('menuJson');",
                  "    const menu = JSON.parse(json.menuJson);",
                  "    pm.expect(menu.days).to.be.an('array').with.lengthOf(7);",
                  "    menu.days.forEach(function (day) {",
                  "        pm.expect(day.meals).to.be.an('array');",
                  "        pm.expect(day.meals.length).to.be.at.least(3);",
                  "    });",
                  "    pm.collectionVariables.set('diet_plan_id', json.id);",
                  "});"
                ]
              }
            }
          ],
