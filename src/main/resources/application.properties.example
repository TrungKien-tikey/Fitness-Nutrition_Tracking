# Copy this file to application.properties.
# Sensitive values are loaded from the .env file at the project root.

# 1. Server Configuration
server.port=8081

# 2. Local secrets loaded from .env (optional, ignored by Git)
spring.config.import=optional:file:.env[.properties]

# 3. Database Connection (MySQL)
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/fitness_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:}

# 4. JPA / Hibernate Properties
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.hibernate.ddl-auto=update
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# 5. Third-party API Integration (Google Gemini AI)
gemini.api.key=${GEMINI_API_KEY:}
gemini.model.name=${GEMINI_MODEL:gemini-3.5-flash}

# 6. JWT Configuration
jwt.secret=${JWT_SECRET:}
jwt.expiration=${JWT_EXPIRATION:86400000}

# 7. API Documentation (Swagger UI / OpenAPI)
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.operationsSorter=method
springdoc.swagger-ui.tagsSorter=alpha
springdoc.swagger-ui.tryItOutEnabled=true
